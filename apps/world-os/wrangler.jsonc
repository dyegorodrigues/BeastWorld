{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beastworld-world-os",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": ["NOTION_TOKEN", "TEAM_DOMAIN", "POLICY_AUD"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NOTION_VERSION": "2026-03-11",
    "NOTION_ENTITY_ATLAS_DATA_SOURCE_ID": "81c9a4b6-5bd8-4516-9572-b946cc4e512f",
    "NOTION_LORE_REGISTRY_DATA_SOURCE_ID": "552bb61b-b295-4737-a3b6-2ea251ed701e",
    "NOTION_EDGE_REGISTRY_DATA_SOURCE_ID": "f874ef52-beca-4d50-8e55-985c563523e9",
    "WORLD_OS_PRIVATE_DATA_ENABLED": "false"
  }
}
